---
 mars/build_ios.py    | 1 +
 mars/comm/strutil.cc | 9 +++++++++
 2 files changed, 10 insertions(+)

diff --git a/mars/build_ios.py b/mars/build_ios.py
index a74e94b5..f20566cf 100755
--- a/mars/build_ios.py
+++ b/mars/build_ios.py
@@ -61,6 +61,7 @@ def build_ios_xlog_archive(platform, archive_name):
         '-DPLATFORM=' + platform,
         '-DDEPLOYMENT_TARGET=' + IOS_XLOG_DEPLOYMENT_TARGET,
         '-DIOS_DEPLOYMENT_TARGET=' + IOS_XLOG_DEPLOYMENT_TARGET,
+        '-DCMAKE_OSX_DEPLOYMENT_TARGET=' + IOS_XLOG_DEPLOYMENT_TARGET,
         '-DENABLE_ARC=0',
         '-DENABLE_BITCODE=0',
         '-DENABLE_VISIBILITY=1',
diff --git a/mars/comm/strutil.cc b/mars/comm/strutil.cc
index f8d52df1..ec27da17 100644
--- a/mars/comm/strutil.cc
+++ b/mars/comm/strutil.cc
@@ -30,7 +30,11 @@
 #include <locale>
 
 #include "comm/xlogger/xlogger.h"
+#if defined(__APPLE__)
+#include <CommonCrypto/CommonDigest.h>
+#else
 #include "openssl/md5.h"
+#endif
 
 #ifdef WIN32
 #define snprintf _snprintf
@@ -334,8 +338,13 @@ std::string BufferMD5(const std::string &buf) {
 }
 
 std::string BufferMD5(const void* buffer, size_t size) {
+#if defined(__APPLE__)
+    uint8_t md5[CC_MD5_DIGEST_LENGTH] = {0};
+    CC_MD5(static_cast<const unsigned char*>(buffer), static_cast<CC_LONG>(size), md5);
+#else
     uint8_t md5[MD5_DIGEST_LENGTH] = {0};
     MD5(static_cast<const unsigned char*>(buffer), static_cast<unsigned int>(size), md5);
+#endif
     return strutil::MD5DigestToBase16(md5);
 }
 
