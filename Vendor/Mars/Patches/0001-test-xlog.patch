+#!/bin/sh
+
+set -eu
+
+SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
+MARS_DIR=$(CDPATH= cd -- "$SCRIPT_DIR/../../.." && pwd)
+TEST_BINARY=$(mktemp "${TMPDIR:-/tmp}/mars-formater-tests.XXXXXX")
+
+cleanup() {
+    rm -f "$TEST_BINARY"
+}
+
+trap cleanup EXIT INT TERM
+
+cd "$MARS_DIR"
+
+xcrun --sdk macosx clang++ -std=gnu++14 -O2 -DNDEBUG -pthread -I. -Imars -Imars/googletest -Imars/googletest/include \
+    mars/xlog/src/formater_unittest.cc \
+    mars/xlog/src/formater.cc \
+    mars/comm/ptrbuffer.cc \
+    mars/comm/xlogger/loginfo_extract.c \
+    mars/googletest/src/gtest-all.cc \
+    -o "$TEST_BINARY"
+
+"$TEST_BINARY" "$@"
