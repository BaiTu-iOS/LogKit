+// Tencent is pleased to support the open source community by making Mars available.
+// Copyright (C) 2016 THL A29 Limited, a Tencent company. All rights reserved.
+
+#include <stdlib.h>
+#include <time.h>
+
+#include <array>
+#include <chrono>
+#include <cstring>
+#include <string>
+
+#include "gtest/gtest.h"
+#include "mars/comm/ptrbuffer.h"
+#include "mars/comm/xlogger/xloggerbase.h"
+
+namespace mars {
+namespace xlog {
+void log_formater(const XLoggerInfo* _info, const char* _logbody, PtrBuffer& _log);
+}
+}
+
+extern "C" void __ASSERT(const char*, int, const char*, const char*) {
+    abort();
+}
+
+namespace {
+
+constexpr time_t kSampleTime = 1785997509;
+constexpr suseconds_t kSampleMicroseconds = 366000;
+constexpr int kBenchmarkIterations = 100000;
+
+class ScopedTimezone {
+ public:
+    explicit ScopedTimezone(const char* timezone) {
+        const char* original_timezone = getenv("TZ");
+        if (nullptr != original_timezone) {
+            original_timezone_ = original_timezone;
+            had_original_timezone_ = true;
+        }
+        setenv("TZ", timezone, 1);
+        tzset();
+    }
+
+    ~ScopedTimezone() {
+        if (had_original_timezone_) {
+            setenv("TZ", original_timezone_.c_str(), 1);
+        } else {
+            unsetenv("TZ");
+        }
+        tzset();
+    }
+
+ private:
+    bool had_original_timezone_ = false;
+    std::string original_timezone_;
+};
+
+XLoggerInfo MakeInfo(TLogLevel level, time_t seconds, suseconds_t microseconds, const char* tag) {
+    XLoggerInfo info = XLOGGER_INFO_INITIALIZER;
+    info.level = level;
+    info.tag = tag;
+    info.filename = "/tmp/source.cc";
+    info.func_name = "void FormatTest()";
+    info.line = 42;
+    info.timeval.tv_sec = seconds;
+    info.timeval.tv_usec = microseconds;
+    info.pid = 100;
+    info.tid = 200;
+    info.maintid = 200;
+    return info;
+}
+
+std::string Format(const XLoggerInfo& info, const char* body) {
+    std::array<char, 32 * 1024> storage = {};
+    PtrBuffer buffer(storage.data(), 0, storage.size());
+    mars::xlog::log_formater(&info, body, buffer);
+    return std::string(storage.data(), buffer.Length());
+}
+
+void FormatUpstreamTime(const XLoggerInfo& info, char* output, size_t output_size) {
+    time_t seconds = info.timeval.tv_sec;
+    tm local_time = {};
+    localtime_r(&seconds, &local_time);
+    snprintf(output, output_size, "%d-%02d-%02d %+.1f %02d:%02d:%02d.%.3d", 1900 + local_time.tm_year, 1 + local_time.tm_mon, local_time.tm_mday, local_time.tm_gmtoff / 3600.0, local_time.tm_hour, local_time.tm_min, local_time.tm_sec, info.timeval.tv_usec / 1000);
+}
+
+TEST(formater, device_and_beijing_time_use_same_timeval) {
+    ScopedTimezone timezone("America/New_York");
+    XLoggerInfo info = MakeInfo(kLevelInfo, kSampleTime, kSampleMicroseconds, "moduleName");
+    EXPECT_EQ(Format(info, "body"), "[I][2026-08-06 -40 02:25:09.366][2026-08-06 +80 14:25:09.366][moduleName]body\n");
+}
+
+TEST(formater, shanghai_device_time_matches_beijing_time) {
+    ScopedTimezone timezone("Asia/Shanghai");
+    XLoggerInfo info = MakeInfo(kLevelDebug, kSampleTime, kSampleMicroseconds, "moduleName");
+    EXPECT_EQ(Format(info, "body"), "[D][2026-08-06 +80 14:25:09.366][2026-08-06 +80 14:25:09.366][moduleName]body\n");
+}
+
+TEST(formater, beijing_time_advances_across_year_boundary) {
+    ScopedTimezone timezone("UTC");
+    XLoggerInfo info = MakeInfo(kLevelFatal, 1767223800, 999000, "year");
+    EXPECT_EQ(Format(info, "body"), "[F][2025-12-31 +0 23:30:00.999][2026-01-01 +80 07:30:00.999][year]body\n");
+}
+
+TEST(formater, zero_timestamp_keeps_two_empty_time_columns) {
+    XLoggerInfo info = MakeInfo(kLevelInfo, 0, 0, "");
+    EXPECT_EQ(Format(info, "body"), "[I][][][]body\n");
+}
+
+TEST(formater, null_body_uses_fatal_level_and_error_text) {
+    XLoggerInfo info = MakeInfo(kLevelInfo, 0, 0, nullptr);
+    EXPECT_EQ(Format(info, nullptr), "[F][][][]error!! NULL==_logbody\n");
+}
+
+TEST(formater, existing_newline_is_not_duplicated) {
+    ScopedTimezone timezone("Asia/Shanghai");
+    XLoggerInfo info = MakeInfo(kLevelInfo, kSampleTime, kSampleMicroseconds, "moduleName");
+    std::string formatted = Format(info, "body\n");
+    EXPECT_EQ(formatted.back(), '\n');
+    EXPECT_NE(formatted[formatted.size() - 2], '\n');
+}
+
+TEST(formater, oversized_body_is_bounded_by_output_buffer) {
+    ScopedTimezone timezone("Asia/Shanghai");
+    XLoggerInfo info = MakeInfo(kLevelInfo, kSampleTime, kSampleMicroseconds, "moduleName");
+    std::string body(64 * 1024, 'x');
+    std::string formatted = Format(info, body.c_str());
+    EXPECT_LT(formatted.size(), 32 * 1024);
+    EXPECT_EQ(formatted.back(), '\n');
+}
+
+TEST(formater, dual_time_increment_stays_below_five_microseconds) {
+    ScopedTimezone timezone("Asia/Shanghai");
+    XLoggerInfo info = MakeInfo(kLevelInfo, kSampleTime, kSampleMicroseconds, "moduleName");
+    std::array<char, 128> baseline_output = {};
+
+    auto baseline_start = std::chrono::steady_clock::now();
+    for (int index = 0; index < kBenchmarkIterations; ++index) FormatUpstreamTime(info, baseline_output.data(), baseline_output.size());
+    auto baseline_end = std::chrono::steady_clock::now();
+
+    auto dual_time_start = std::chrono::steady_clock::now();
+    for (int index = 0; index < kBenchmarkIterations; ++index) Format(info, "body");
+    auto dual_time_end = std::chrono::steady_clock::now();
+
+    double baseline_microseconds = std::chrono::duration<double, std::micro>(baseline_end - baseline_start).count();
+    double dual_time_microseconds = std::chrono::duration<double, std::micro>(dual_time_end - dual_time_start).count();
+    double incremental_microseconds = (dual_time_microseconds - baseline_microseconds) / kBenchmarkIterations;
+    EXPECT_LE(incremental_microseconds, 5.0);
+}
+
+}  // namespace
+
+int main(int argc, char** argv) {
+    testing::InitGoogleTest(&argc, argv);
+    return RUN_ALL_TESTS();
+}
