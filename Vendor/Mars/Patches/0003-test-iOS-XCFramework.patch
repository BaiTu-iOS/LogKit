--- /dev/null
+++ b/mars/xlog/tests/verify_ios_xcframework_unittest.py
@@ -0,0 +1,54 @@
+import importlib.util
+import plistlib
+import tempfile
+import unittest
+from pathlib import Path
+
+
+MODULE_PATH = Path(__file__).with_name("verify_ios_xcframework.py")
+MODULE_SPEC = importlib.util.spec_from_file_location("verify_ios_xcframework", MODULE_PATH)
+validator = importlib.util.module_from_spec(MODULE_SPEC)
+MODULE_SPEC.loader.exec_module(validator)
+
+
+class VerifyIOSXCFrameworkTests(unittest.TestCase):
+    def test_missing_xcframework_is_rejected(self) -> None:
+        with tempfile.TemporaryDirectory() as temporary_directory:
+            missing_path = Path(temporary_directory) / "mars.xcframework"
+            with self.assertRaisesRegex(validator.ValidationError, "does not exist"):
+                validator.validate_xcframework(missing_path)
+
+    def test_wrong_library_identifiers_are_rejected(self) -> None:
+        with tempfile.TemporaryDirectory() as temporary_directory:
+            xcframework_path = Path(temporary_directory) / "mars.xcframework"
+            xcframework_path.mkdir()
+            info = {"AvailableLibraries": [{"LibraryIdentifier": "ios-arm64"}]}
+            with (xcframework_path / "Info.plist").open("wb") as info_file:
+                plistlib.dump(info, info_file)
+            with self.assertRaisesRegex(validator.ValidationError, "library identifiers mismatch"):
+                validator.validate_xcframework(xcframework_path)
+
+    def test_wrong_architectures_are_rejected_before_binary_inspection(self) -> None:
+        with tempfile.TemporaryDirectory() as temporary_directory:
+            xcframework_path = Path(temporary_directory) / "mars.xcframework"
+            xcframework_path.mkdir()
+            libraries = []
+            for identifier, expected in validator.EXPECTED_LIBRARIES.items():
+                architectures = ["x86_64"] if identifier == "ios-arm64" else sorted(expected["architectures"])
+                library = {
+                    "LibraryIdentifier": identifier,
+                    "LibraryPath": "mars.framework",
+                    "SupportedArchitectures": architectures,
+                    "SupportedPlatform": expected["platform"],
+                }
+                if expected["variant"] is not None:
+                    library["SupportedPlatformVariant"] = expected["variant"]
+                libraries.append(library)
+            with (xcframework_path / "Info.plist").open("wb") as info_file:
+                plistlib.dump({"AvailableLibraries": libraries}, info_file)
+            with self.assertRaisesRegex(validator.ValidationError, "architectures mismatch"):
+                validator.validate_xcframework(xcframework_path)
+
+
+if __name__ == "__main__":
+    unittest.main()
