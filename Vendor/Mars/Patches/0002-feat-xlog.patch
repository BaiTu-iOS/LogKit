---
 mars/xlog/src/formater.cc | 61 ++++++++++++++++++++++++++++++++++++++-
 1 file changed, 60 insertions(+), 1 deletion(-)

diff --git a/mars/xlog/src/formater.cc b/mars/xlog/src/formater.cc
index 2f7a3f97..404a83e5 100644
--- a/mars/xlog/src/formater.cc
+++ b/mars/xlog/src/formater.cc
@@ -37,6 +37,43 @@
 
 namespace mars {
 namespace xlog {
+#if defined(__APPLE__)
+static bool FormatAppleTimes(const timeval& _timeval,
+                             char* _local_time,
+                             size_t _local_time_size,
+                             char* _beijing_time,
+                             size_t _beijing_time_size) {
+    time_t seconds = _timeval.tv_sec;
+    time_t beijing_seconds = seconds + 8 * 60 * 60;
+    tm local_time = {};
+    tm beijing_time = {};
+    if (NULL == localtime_r(&seconds, &local_time) || NULL == gmtime_r(&beijing_seconds, &beijing_time)) return false;
+
+    int local_ret = snprintf(_local_time,
+                             _local_time_size,
+                             "%d-%02d-%02d %+ld %02d:%02d:%02d.%.3d",
+                             1900 + local_time.tm_year,
+                             1 + local_time.tm_mon,
+                             local_time.tm_mday,
+                             local_time.tm_gmtoff / 360,
+                             local_time.tm_hour,
+                             local_time.tm_min,
+                             local_time.tm_sec,
+                             _timeval.tv_usec / 1000);
+    int beijing_ret = snprintf(_beijing_time,
+                               _beijing_time_size,
+                               "%d-%02d-%02d +80 %02d:%02d:%02d.%.3d",
+                               1900 + beijing_time.tm_year,
+                               1 + beijing_time.tm_mon,
+                               beijing_time.tm_mday,
+                               beijing_time.tm_hour,
+                               beijing_time.tm_min,
+                               beijing_time.tm_sec,
+                               _timeval.tv_usec / 1000);
+    return 0 <= local_ret && (size_t)local_ret < _local_time_size && 0 <= beijing_ret && (size_t)beijing_ret < _beijing_time_size;
+}
+#endif
+
 void log_formater(const XLoggerInfo* _info, const char* _logbody, PtrBuffer& _log) {
     static const char* levelStrings[] = {
         "V",
@@ -74,6 +111,7 @@ void log_formater(const XLoggerInfo* _info, const char* _logbody, PtrBuffer& _lo
     }
 
     if (NULL != _info) {
+#if !defined(__APPLE__)
         const char* filename = ExtractFileName(_info->filename);
 
 #if _WIN32
@@ -81,11 +119,21 @@ void log_formater(const XLoggerInfo* _info, const char* _logbody, PtrBuffer& _lo
         ExtractFunctionName(_info->func_name, strFuncName, sizeof(strFuncName));
 #else
         const char* strFuncName = NULL == _info->func_name ? "" : _info->func_name;
+#endif
 #endif
 
         char temp_time[64] = {0};
+#if defined(__APPLE__)
+        char beijing_time[64] = {0};
+#endif
 
         if (0 != _info->timeval.tv_sec) {
+#if defined(__APPLE__)
+            if (!FormatAppleTimes(_info->timeval, temp_time, sizeof(temp_time), beijing_time, sizeof(beijing_time))) {
+                temp_time[0] = '\0';
+                beijing_time[0] = '\0';
+            }
+#else
             time_t sec = _info->timeval.tv_sec;
             tm tm = *localtime((const time_t*)&sec);
 
@@ -125,10 +173,20 @@ void log_formater(const XLoggerInfo* _info, const char* _logbody, PtrBuffer& _lo
                      tm.tm_min,
                      tm.tm_sec,
                      _info->timeval.tv_usec / 1000);
+#endif
 #endif
         }
 
         // _log.AllocWrite(30*1024, false);
+#if defined(__APPLE__)
+        int ret = snprintf((char*)_log.PosPtr(),
+                           1024,
+                           "[%s][%s][%s][%s]",
+                           _logbody ? levelStrings[_info->level] : levelStrings[kLevelFatal],
+                           temp_time,
+                           beijing_time,
+                           _info->tag ? _info->tag : "");
+#else
         int ret = snprintf((char*)_log.PosPtr(),
                            1024,
                            "[%s][%s][%" PRIdMAX ", %" PRIdMAX "%s][%s][%s:%d, %s][",  // **CPPLINT SKIP**
@@ -141,6 +199,7 @@ void log_formater(const XLoggerInfo* _info, const char* _logbody, PtrBuffer& _lo
                            filename,
                            _info->line,
                            strFuncName);
+#endif
 
         assert(0 <= ret);
         _log.Length(_log.Pos() + ret, _log.Length() + ret);
@@ -168,4 +227,4 @@ void log_formater(const XLoggerInfo* _info, const char* _logbody, PtrBuffer& _lo
 }
 
 }  // namespace xlog
-}  // namespace mars
\ No newline at end of file
+}  // namespace mars
