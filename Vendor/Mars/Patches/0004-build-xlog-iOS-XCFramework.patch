 #!/usr/bin/env python3
+import glob
 import os
+import plistlib
+import shutil
+import subprocess
 import sys
-import glob
+from pathlib import Path
 
 from mars_utils import *
 
@@ -17,6 +21,137 @@ IOS_BUILD_OS_CMD = 'cmake ../.. -DCMAKE_BUILD_TYPE=Release -DCMAKE_TOOLCHAIN_FIL
 GEN_IOS_OS_PROJ = 'cmake ../.. -G Xcode -DCMAKE_TOOLCHAIN_FILE=../../ios.toolchain.cmake -DPLATFORM=OS -DIOS_ARCH="arm64" -DENABLE_ARC=0 -DENABLE_BITCODE=0 -DENABLE_VISIBILITY=1'
 OPEN_SSL_ARCHS = ['x86_64', 'arm64']
 
+IOS_XLOG_XCFRAMEWORK_BUILD_PATH = Path(SCRIPT_PATH) / 'cmake_build/iOS-xlog-xcframework'
+IOS_XLOG_PLATFORMS = (
+    ('OS64', 'ios-arm64'),
+    ('SIMULATORARM64', 'simulator-arm64'),
+    ('SIMULATOR64', 'simulator-x86_64'),
+)
+IOS_XLOG_DEPLOYMENT_TARGET = '13.0'
+IOS_XLOG_BUILD_TARGETS = ('comm', 'mars-boost', 'xlog', 'libzstd_static')
+IOS_XLOG_STATIC_LIBS = ('comm/libcomm.a', 'boost/libmars-boost.a', 'xlog/libxlog.a', 'zstd/libzstd.a')
+
+
+def run_command(arguments, cwd=None):
+    print(' '.join(str(argument) for argument in arguments), flush=True)
+    try:
+        subprocess.run([str(argument) for argument in arguments], cwd=cwd, check=True)
+    except subprocess.CalledProcessError as error:
+        print('!!!!!!!!!!!command fail, exit code %d!!!!!!!!!!!!!!!' % error.returncode)
+        return False
+    except OSError as error:
+        print('!!!!!!!!!!!unable to run command: %s!!!!!!!!!!!!!!!' % error)
+        return False
+    return True
+
+
+def build_ios_xlog_archive(platform, archive_name):
+    build_path = IOS_XLOG_XCFRAMEWORK_BUILD_PATH / ('build-' + platform.lower())
+    if build_path.exists():
+        shutil.rmtree(build_path)
+    build_path.mkdir(parents=True)
+    configure_arguments = [
+        'cmake',
+        '-S',
+        SCRIPT_PATH,
+        '-B',
+        build_path,
+        '-DCMAKE_BUILD_TYPE=Release',
+        '-DCMAKE_TOOLCHAIN_FILE=' + str(Path(SCRIPT_PATH) / 'ios.toolchain.cmake'),
+        '-DPLATFORM=' + platform,
+        '-DDEPLOYMENT_TARGET=' + IOS_XLOG_DEPLOYMENT_TARGET,
+        '-DIOS_DEPLOYMENT_TARGET=' + IOS_XLOG_DEPLOYMENT_TARGET,
+        '-DENABLE_ARC=0',
+        '-DENABLE_BITCODE=0',
+        '-DENABLE_VISIBILITY=1',
+    ]
+    if not run_command(configure_arguments):
+        return None
+    build_arguments = ['cmake', '--build', build_path, '--target']
+    build_arguments.extend(IOS_XLOG_BUILD_TARGETS)
+    build_arguments.extend(['--parallel', '8'])
+    if not run_command(build_arguments):
+        return None
+
+    source_libraries = [build_path / library for library in IOS_XLOG_STATIC_LIBS]
+    for source_library in source_libraries:
+        if not source_library.is_file():
+            print('!!!!!!!!!!!missing static library: %s!!!!!!!!!!!!!!!' % source_library)
+            return None
+
+    archive_path = IOS_XLOG_XCFRAMEWORK_BUILD_PATH / 'archives' / archive_name / 'mars'
+    archive_path.parent.mkdir(parents=True, exist_ok=True)
+    libtool_arguments = ['xcrun', 'libtool', '-static', '-no_warning_for_no_symbols', '-o', archive_path]
+    libtool_arguments.extend(source_libraries)
+    if not run_command(libtool_arguments):
+        return None
+    return archive_path
+
+
+def write_framework_info_plist(framework_path):
+    info = {
+        'CFBundleDevelopmentRegion': 'en',
+        'CFBundleExecutable': 'mars',
+        'CFBundleIdentifier': 'com.tencent.mars.xlog',
+        'CFBundleInfoDictionaryVersion': '6.0',
+        'CFBundleName': 'mars',
+        'CFBundlePackageType': 'FMWK',
+        'CFBundleShortVersionString': '1.0',
+        'CFBundleVersion': '1',
+        'MinimumOSVersion': IOS_XLOG_DEPLOYMENT_TARGET,
+    }
+    with (framework_path / 'Info.plist').open('wb') as info_file:
+        plistlib.dump(info, info_file)
+
+
+def make_ios_xlog_framework(archive_path, framework_name):
+    framework_path = IOS_XLOG_XCFRAMEWORK_BUILD_PATH / 'frameworks' / framework_name / 'mars.framework'
+    source_base_path = str(Path(SCRIPT_PATH).parent)
+    make_static_framework(str(archive_path), str(framework_path), XLOG_COPY_HEADER_FILES, source_base_path)
+    write_framework_info_plist(framework_path)
+    return framework_path
+
+
+def build_ios_xlog_xcframework(tag=''):
+    gen_mars_revision_file(str(Path(SCRIPT_PATH) / 'comm'), tag)
+    if IOS_XLOG_XCFRAMEWORK_BUILD_PATH.exists():
+        shutil.rmtree(IOS_XLOG_XCFRAMEWORK_BUILD_PATH)
+    IOS_XLOG_XCFRAMEWORK_BUILD_PATH.mkdir(parents=True)
+
+    archives = {}
+    for platform, archive_name in IOS_XLOG_PLATFORMS:
+        archive_path = build_ios_xlog_archive(platform, archive_name)
+        if archive_path is None:
+            return False
+        archives[archive_name] = archive_path
+
+    simulator_archive = IOS_XLOG_XCFRAMEWORK_BUILD_PATH / 'archives/simulator-universal/mars'
+    simulator_archive.parent.mkdir(parents=True)
+    lipo_arguments = ['xcrun', 'lipo', '-create', archives['simulator-arm64'], archives['simulator-x86_64']]
+    lipo_arguments.extend(['-output', simulator_archive])
+    if not run_command(lipo_arguments):
+        return False
+
+    device_framework = make_ios_xlog_framework(archives['ios-arm64'], 'ios-arm64')
+    simulator_framework = make_ios_xlog_framework(simulator_archive, 'ios-simulator')
+    xcframework_path = IOS_XLOG_XCFRAMEWORK_BUILD_PATH / 'mars.xcframework'
+    create_arguments = [
+        'xcodebuild',
+        '-create-xcframework',
+        '-framework',
+        device_framework,
+        '-framework',
+        simulator_framework,
+        '-output',
+        xcframework_path,
+    ]
+    if not run_command(create_arguments):
+        return False
+
+    print('==================Output========================')
+    print(xcframework_path)
+    return True
+
 
 def build_ios(tag=''):
     gen_mars_revision_file('comm', tag)
@@ -141,6 +276,9 @@ def gen_ios_project():
     return True
 
 def main():
+    if '--xlog-xcframework' in sys.argv:
+        sys.exit(0 if build_ios_xlog_xcframework() else 1)
+
     while True:
         if len(sys.argv) >= 2:
             build_ios(sys.argv[1])
