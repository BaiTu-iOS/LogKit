 2 files changed, 31 insertions(+), 8 deletions(-)

diff --git a/mars/xlog/src/formater.cc b/mars/xlog/src/formater.cc
index 404a83e5..f65c9a8d 100644
--- a/mars/xlog/src/formater.cc
+++ b/mars/xlog/src/formater.cc
@@ -38,16 +38,16 @@
 namespace mars {
 namespace xlog {
 #if defined(__APPLE__)
+constexpr long kBeijingUtcOffsetSeconds = 8 * 60 * 60;
+
 static bool FormatAppleTimes(const timeval& _timeval,
                              char* _local_time,
                              size_t _local_time_size,
                              char* _beijing_time,
                              size_t _beijing_time_size) {
     time_t seconds = _timeval.tv_sec;
-    time_t beijing_seconds = seconds + 8 * 60 * 60;
     tm local_time = {};
-    tm beijing_time = {};
-    if (NULL == localtime_r(&seconds, &local_time) || NULL == gmtime_r(&beijing_seconds, &beijing_time)) return false;
+    if (NULL == localtime_r(&seconds, &local_time)) return false;
 
     int local_ret = snprintf(_local_time,
                              _local_time_size,
@@ -60,6 +60,15 @@ static bool FormatAppleTimes(const timeval& _timeval,
                              local_time.tm_min,
                              local_time.tm_sec,
                              _timeval.tv_usec / 1000);
+    if (0 > local_ret || (size_t)local_ret >= _local_time_size) return false;
+
+    // 当前本地偏移为 UTC+8 时，两列时间相同，省略北京时间以减少冗余与格式化开销。
+    if (kBeijingUtcOffsetSeconds == local_time.tm_gmtoff) return true;
+
+    time_t beijing_seconds = seconds + kBeijingUtcOffsetSeconds;
+    tm beijing_time = {};
+    if (NULL == gmtime_r(&beijing_seconds, &beijing_time)) return false;
+
     int beijing_ret = snprintf(_beijing_time,
                                _beijing_time_size,
                                "%d-%02d-%02d +80 %02d:%02d:%02d.%.3d",
@@ -70,7 +79,7 @@ static bool FormatAppleTimes(const timeval& _timeval,
                                beijing_time.tm_min,
                                beijing_time.tm_sec,
                                _timeval.tv_usec / 1000);
-    return 0 <= local_ret && (size_t)local_ret < _local_time_size && 0 <= beijing_ret && (size_t)beijing_ret < _beijing_time_size;
+    return 0 <= beijing_ret && (size_t)beijing_ret < _beijing_time_size;
 }
 #endif
 
@@ -125,6 +134,7 @@ void log_formater(const XLoggerInfo* _info, const char* _logbody, PtrBuffer& _lo
         char temp_time[64] = {0};
 #if defined(__APPLE__)
         char beijing_time[64] = {0};
+        bool include_beijing_time = true;
 #endif
 
         if (0 != _info->timeval.tv_sec) {
@@ -132,6 +142,9 @@ void log_formater(const XLoggerInfo* _info, const char* _logbody, PtrBuffer& _lo
             if (!FormatAppleTimes(_info->timeval, temp_time, sizeof(temp_time), beijing_time, sizeof(beijing_time))) {
                 temp_time[0] = '\0';
                 beijing_time[0] = '\0';
+                include_beijing_time = true;
+            } else {
+                include_beijing_time = '\0' != beijing_time[0];
             }
 #else
             time_t sec = _info->timeval.tv_sec;
@@ -179,13 +192,23 @@ void log_formater(const XLoggerInfo* _info, const char* _logbody, PtrBuffer& _lo
 
         // _log.AllocWrite(30*1024, false);
 #if defined(__APPLE__)
-        int ret = snprintf((char*)_log.PosPtr(),
+        int ret = 0;
+        if (include_beijing_time) {
+            ret = snprintf((char*)_log.PosPtr(),
                            1024,
                            "[%s][%s][%s][%s]",
                            _logbody ? levelStrings[_info->level] : levelStrings[kLevelFatal],
                            temp_time,
                            beijing_time,
                            _info->tag ? _info->tag : "");
+        } else {
+            ret = snprintf((char*)_log.PosPtr(),
+                           1024,
+                           "[%s][%s][%s]",
+                           _logbody ? levelStrings[_info->level] : levelStrings[kLevelFatal],
+                           temp_time,
+                           _info->tag ? _info->tag : "");
+        }
 #else
         int ret = snprintf((char*)_log.PosPtr(),
                            1024,
