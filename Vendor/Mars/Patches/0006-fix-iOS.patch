---
 mars/xlog/objc/objc_console.mm         | 51 +++++++++-----------------
 mars/xlog/src/formater_unittest.cc     | 13 +++++++
 mars/xlog/tests/run_formatter_tests.sh |  3 ++
 3 files changed, 34 insertions(+), 33 deletions(-)

diff --git a/mars/xlog/objc/objc_console.mm b/mars/xlog/objc/objc_console.mm
index 0e37ba58..840270a5 100644
--- a/mars/xlog/objc/objc_console.mm
+++ b/mars/xlog/objc/objc_console.mm
@@ -14,7 +14,7 @@
 #import <Foundation/Foundation.h>
 #import <os/log.h>
 #import "comm/objc/scope_autoreleasepool.h"
-#include "comm/xlogger/loginfo_extract.h"
+#include "comm/ptrbuffer.h"
 #include "comm/xlogger/xlogger.h"
 #include "mars/xlog/appender.h"
 
@@ -23,24 +23,19 @@
 
 static TConsoleFun sg_console_fun = TConsoleFun::kConsoleOSLog;
 
+void log_formater(const XLoggerInfo* _info, const char* _logbody, PtrBuffer& _log);
+
 void appender_set_console_fun(TConsoleFun _fun) { sg_console_fun = _fun; }
 
 void ConsoleLog(const XLoggerInfo* _info, const char* _log) {
     SCOPE_POOL();
 
+    // 上游未提供完整日志信息时无法生成稳定前缀，保持原行为并跳过控制台输出
     if (NULL == _info || NULL == _log) return;
 
-    static const char* levelStrings[] = {
-        "V",
-        "D",  // debug
-        "I",  // info
-        "W",  // warn
-        "E",  // error
-        "F"   // fatal
-    };
-
-    const char* strFuncName = NULL == _info->func_name ? "" : _info->func_name;
-    const char* file_name = ExtractFileName(_info->filename);
+    char formatted_log[16 * 1024] = {0};
+    PtrBuffer formatted_buffer(formatted_log, 0, sizeof(formatted_log));
+    log_formater(_info, _log, formatted_buffer);
 
     if (kConsoleOSLog == sg_console_fun) {
         os_log_t log_t = os_log_create("", NULL == _info->tag ? "" : _info->tag);
@@ -48,44 +43,34 @@ void ConsoleLog(const XLoggerInfo* _info, const char* _log) {
         switch (_info->level) {
             case kLevelVerbose:
             case kLevelDebug:
+                // 调试日志使用 debug 类型，避免污染默认级别控制台
                 type = OS_LOG_TYPE_DEBUG;
                 break;
             case kLevelInfo:
             case kLevelWarn:
+                // 常规信息与告警沿用 info 类型，保持现有 Console 过滤行为
                 type = OS_LOG_TYPE_INFO;
                 break;
             case kLevelError:
+                // 错误日志标记为 error，便于 Console 按严重级别筛选
                 type = OS_LOG_TYPE_ERROR;
                 break;
             case kLevelFatal:
+                // 致命日志标记为 fault，保留最高严重级别
                 type = OS_LOG_TYPE_FAULT;
                 break;
             default:
                 break;
         }
-        os_log_with_type(log_t, type, "[%s:%d, %s][%s", file_name, _info->line, strFuncName, _log);
+        os_log_with_type(log_t, type, "%{public}s", formatted_log);
     } else if (kConsoleNSLog == sg_console_fun) {
-        NSLog(@"[%s][%s][%s:%d, %s][%s", levelStrings[_info->level],
-              NULL == _info->tag ? "" : _info->tag, file_name, _info->line, strFuncName, _log);
+        // NSLog 模式也复用文件 formatter，避免调试输出与解码后的文件格式不一致
+        NSLog(@"%s", formatted_log);
     } else {
-        char log[16 * 1024] = {0};
-        struct timeval tv;
-        gettimeofday(&tv, nullptr);
-        time_t sec = _info->timeval.tv_sec;
-        tm tm = *localtime((const time_t*)&sec);
-        char temp_time[64] = {0};
-        snprintf(temp_time, sizeof(temp_time), "%d-%02d-%02d %+.1f %02d:%02d:%02d.%.3d",
-                 1900 + tm.tm_year, 1 + tm.tm_mon, tm.tm_mday, tm.tm_gmtoff / 3600.0, tm.tm_hour,
-                 tm.tm_min, tm.tm_sec, _info->timeval.tv_usec / 1000);
-
-        snprintf(log, sizeof(log),
-                 "[%s][%s][%" PRIdMAX ", %" PRIdMAX "%s][%s][%s:%d, %s][%s",  // **CPPLINT SKIP**
-                 levelStrings[_info->level], temp_time, _info->pid, _info->tid,
-                 _info->tid == _info->maintid ? "*" : "", _info->tag ? _info->tag : "", file_name,
-                 _info->line, strFuncName, _log);
-        printf("%s\n", log);
+        // printf 模式用于命令行与测试环境，同样保持唯一的格式定义
+        printf("%s", formatted_log);
     }
 }
 
-}  // xlog
-}  // mars
+}  // namespace xlog
+}  // namespace mars
diff --git a/mars/xlog/src/formater_unittest.cc b/mars/xlog/src/formater_unittest.cc
index 95a28063..2cc89696 100644
--- a/mars/xlog/src/formater_unittest.cc
+++ b/mars/xlog/src/formater_unittest.cc
@@ -12,9 +12,11 @@
 #include "gtest/gtest.h"
 #include "mars/comm/ptrbuffer.h"
 #include "mars/comm/xlogger/xloggerbase.h"
+#include "mars/xlog/appender.h"
 
 namespace mars {
 namespace xlog {
+void ConsoleLog(const XLoggerInfo* _info, const char* _log);
 void log_formater(const XLoggerInfo* _info, const char* _logbody, PtrBuffer& _log);
 }
 }
@@ -96,6 +98,17 @@ TEST(formater, shanghai_device_time_matches_beijing_time) {
     EXPECT_EQ(Format(info, "body"), "[D][2026-08-06 +80 14:25:09.366][2026-08-06 +80 14:25:09.366][moduleName]body\n");
 }
 
+TEST(formater, console_printf_matches_file_formatter) {
+    ScopedTimezone timezone("Asia/Shanghai");
+    XLoggerInfo info = MakeInfo(kLevelInfo, kSampleTime, kSampleMicroseconds, "moduleName");
+    mars::xlog::appender_set_console_fun(mars::xlog::kConsolePrintf);
+    testing::internal::CaptureStdout();
+    mars::xlog::ConsoleLog(&info, "body");
+    std::string output = testing::internal::GetCapturedStdout();
+    mars::xlog::appender_set_console_fun(mars::xlog::kConsoleOSLog);
+    EXPECT_EQ(output, "[I][2026-08-06 +80 14:25:09.366][2026-08-06 +80 14:25:09.366][moduleName]body\n");
+}
+
 TEST(formater, beijing_time_advances_across_year_boundary) {
     ScopedTimezone timezone("UTC");
     XLoggerInfo info = MakeInfo(kLevelFatal, 1767223800, 999000, "year");
diff --git a/mars/xlog/tests/run_formatter_tests.sh b/mars/xlog/tests/run_formatter_tests.sh
index 7700f817..c01c8e08 100755
--- a/mars/xlog/tests/run_formatter_tests.sh
+++ b/mars/xlog/tests/run_formatter_tests.sh
@@ -17,9 +17,12 @@ cd "$MARS_DIR"
 xcrun --sdk macosx clang++ -std=gnu++14 -O2 -DNDEBUG -pthread -I. -Imars -Imars/googletest -Imars/googletest/include \
     mars/xlog/src/formater_unittest.cc \
     mars/xlog/src/formater.cc \
+    mars/xlog/objc/objc_console.mm \
+    mars/comm/objc/scope_autoreleasepool.mm \
     mars/comm/ptrbuffer.cc \
     mars/comm/xlogger/loginfo_extract.c \
     mars/googletest/src/gtest-all.cc \
+    -framework Foundation \
     -o "$TEST_BINARY"
 
 "$TEST_BINARY" "$@"
